{
    "name": "totalcms/color-thief-php",
    "type": "library",
    "homepage": "https://github.com/totalcms/color-thief-php",
    "description": "Maintained fork of ksubileau/color-thief-php with PHP 8.2+ deprecation fixes. Temporary bridge for Total CMS until the upstream 3.0 release.",
    "keywords": ["color", "thief", "php", "dominant", "palette"],
    "license": "MIT",

    "authors": [
        {
            "name": "Kevin Subileau",
            "homepage": "http://www.kevinsubileau.fr",
            "role": "Original author"
        },
        {
            "name": "Joe Workman",
            "homepage": "https://totalcms.co",
            "role": "Fork maintainer"
        }
    ],

    "support": {
        "issues": "https://github.com/totalcms/color-thief-php/issues",
        "source": "https://github.com/totalcms/color-thief-php"
    },

    "require": {
        "php": "^8.2",
        "ext-fileinfo": "*"
    },

    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "friendsofphp/php-cs-fixer": "^3.75",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "rector/rector": "^2.4"
    },

    "suggest": {
        "ext-gd": "to use the GD image adapter.",
        "ext-imagick": "to use the Imagick image adapter.",
        "ext-gmagick": "to use the Gmagick image adapter."
    },

    "autoload": {
        "psr-4": {
            "ColorThief\\": "src/ColorThief"
        }
    },

    "autoload-dev": {
        "psr-4": {
            "ColorThief\\Tests\\": "tests/"
        }
    },

    "scripts": {
        "test": "phpunit",
        "stan": ["phpstan clear-result-cache", "phpstan analyse"],
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "rector": "rector process --dry-run",
        "rector:fix": "rector process",
        "quality": ["@stan", "@cs", "@rector"],
        "clean": ["@rector:fix", "@cs:fix"]
    }
}
